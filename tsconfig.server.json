{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["server", "src/network/protocol.ts", "src/network/codec.ts", "src/core/timestep.ts", "src/core/rng.ts", "src/game/brawlEngine.ts"],
  "exclude": ["**/*.test.ts"]
}
